{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "b1e3bf4f90434e5bb4d92be3f14b44dd",
    "m_Title": "Texture Bombing",
    "m_Content": "Low-frequency noise picks a variation index per area. Each index gives a pseudo-random UV offset (sin(index * (3,7))). The texture is sampled with two neighbouring offsets and cross-faded, so the repeating tile pattern breaks up. Samples use Gradient mip mode with the derivatives of the un-offset UV so no seams appear where offsets change. Offsets only (no rotation) so normal maps stay valid.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -3000.0,
        "y": -640.0,
        "width": 420.0,
        "height": 170.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

